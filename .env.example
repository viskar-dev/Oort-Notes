# ============================================================
# Oort Notes — development environment (copy to .env)
# ============================================================
# One file feeds every part of the app:
#   * note-server  (web shell)    — reads this at startup via dotenvy
#   * desktop dev  (tauri dev)    — reads this at startup via dotenvy
#   * frontend     (vite dev)     — reads VITE_* vars from the same file
#
# .env is gitignored — never commit real secrets.
# Runtime env vars already set in your shell ALWAYS win over this file.

# ---------- Google OAuth (desktop = client id only) ----------
# Desktop: create a "Desktop app" OAuth client in Google Cloud Console.
# Desktop uses PKCE in the system browser — NO client secret is needed or sent.
GOOGLE_CLIENT_ID=

# Web shell only: create a separate "Web application" OAuth client and set
# its secret here (never reuse the desktop client's id for web or vice versa).
GOOGLE_CLIENT_SECRET=

# Distribution only (compile-time): builds the desktop client id INTO the
# binary so end users never configure anything:
#   $env:OORT_GOOGLE_CLIENT_ID="...apps.googleusercontent.com"; cargo tauri build
# OORT_GOOGLE_CLIENT_ID=

# ---------- Web shell URLs ----------
# Where the web OAuth callback lives (note-server) and where the callback
# redirects back to the frontend.
# GOOGLE_REDIRECT_BASE=http://localhost:3000
# APP_WEB_URL=http://localhost:1420

# ---------- Server ----------
# DATABASE_URL=sqlite:oort.db

# ---------- Frontend ----------
# Where the web frontend finds the API (defaults to http://localhost:3000).
# VITE_API_URL=http://localhost:3000
