{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oort Notes",
  "version": "0.2.0",
  "identifier": "com.oort.desktop",
  "build": {
     "beforeDevCommand": "bun run --cwd ../frontend dev",
     "beforeBuildCommand": "bun run --cwd ../frontend build",
     "devUrl": "http://localhost:1420",
     "frontendDist": "../../frontend/dist"
   },
  "app": {
    "windows": [
      {
        "title": "desktop",
        "width": 800,
        "height": 600,
        "decorations": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark",
        "zoomHotkeysEnabled": true,
        "dragDropEnabled": false

      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/viskar-dev/Oort-Notes/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBRkZEMjAwQzBFMjQyMjcKUldRblF1TEFBTkwvV3JzeHVEaXc5cWdlcitvRWFKdk15ajNCWWoyc00rNEMzWDJ0YVZiWGltbWcK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
